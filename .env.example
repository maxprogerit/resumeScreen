# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# SQLite for local dev; PostgreSQL URL is shown below (matches docker-compose.yml).
DATABASE_URL=sqlite:///./resume_screener.db
# DATABASE_URL=postgresql+psycopg://resume:resume@localhost:5434/resume_screener

# Bearer key for the demo API. Generate a long random string.
API_KEY_ADMIN=change-me

MAX_UPLOAD_MB=10
# Candidates older than this are purged by the retention job. 0 = retention disabled.
RETENTION_DAYS=90

# Optional: default scoring weights (0-100, relative). Editable at runtime on the Settings page.
# WEIGHT_MUST_HAVE=40
# WEIGHT_NICE_TO_HAVE=10
# WEIGHT_EXPERIENCE=15
# WEIGHT_SEMANTIC=20
# WEIGHT_LANGUAGE_EDUCATION=15
# MAX_FILES_PER_UPLOAD=10
# UPLOAD_RATE_LIMIT_PER_MINUTE=20
# Interactive API docs at /docs (off by default).
# ENABLE_DOCS=true
